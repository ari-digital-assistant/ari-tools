venv/

# OS
.DS_Store

# Wake-word corpora. Household voice recordings and capture exports must never
# be committed: they are personal audio, they are large, and the eval set's
# value depends on it staying held out rather than published.
wakeword/corpus/
wakeword/eval/
wakeword/models/
wakeword/*.wav

# Upstream clones. Present only to supply subpackages that upstream's own
# packaging drops (piper_train; microwakeword.audio and .layers). See
# wakeword/README.md.
wakeword/generate/upstream/
wakeword/train/upstream/
